{
  "folders": [
    {
      "name": "vwbhist_test",
      "path": "."
    }
  ],
  "settings": {
    "files.associations": {
      "*.settings.txt": "properties",
      "*.changes.txt": "diff",
      "history.log": "log"
    },
    "files.exclude": {
      "**/__pycache__": true
    },
    "python.analysis.extraPaths": [
      "./vwbhist"
    ]
  },
  "tasks": {
    "version": "2.0.0",
    "options": {
      "cwd": "${workspaceFolder:vwbhist_test}"
    },
    "presentation": {
      "reveal": "always",
      "panel": "shared",
      "clear": true
    },
    "tasks": [
      {
        "label": "1. Self-test (both demo workbenches)",
        "type": "shell",
        "command": "python tests/selftest.py",
        "group": {
          "kind": "test",
          "isDefault": true
        },
        "problemMatcher": []
      },
      {
        "label": "2. Compare demo workbenches -> reports/compare_demo.txt",
        "type": "shell",
        "command": "python vwbhist/vwbhist.py compare workbenches/six_step_to_PWM.pVWB workbenches/EPT_SC_demo.pVWB > reports/compare_demo.txt; code reports/compare_demo.txt",
        "windows": {
          "command": "if not exist reports mkdir reports & python vwbhist\\vwbhist.py compare workbenches\\six_step_to_PWM.pVWB workbenches\\EPT_SC_demo.pVWB > reports\\compare_demo.txt & code reports\\compare_demo.txt",
          "options": {
            "shell": {
              "executable": "cmd.exe",
              "args": [
                "/d",
                "/c"
              ]
            }
          }
        },
        "problemMatcher": []
      },
      {
        "label": "3. Reset working copy (Test.pVWB = six-step)",
        "type": "shell",
        "command": "python tests/workcopy.py reset",
        "problemMatcher": []
      },
      {
        "label": "4. Simulate edit (Test.pVWB = SC demo)",
        "type": "shell",
        "command": "python tests/workcopy.py edit",
        "problemMatcher": []
      },
      {
        "label": "5. Snapshot Test.pVWB",
        "type": "shell",
        "command": "python vwbhist/vwbhist.py snapshot workbenches/Test.pVWB -m \"${input:note}\"",
        "problemMatcher": []
      },
      {
        "label": "6. Log Test.pVWB",
        "type": "shell",
        "command": "python vwbhist/vwbhist.py log workbenches/Test.pVWB",
        "problemMatcher": []
      },
      {
        "label": "7. Diff last two versions of Test.pVWB",
        "type": "shell",
        "command": "python vwbhist/vwbhist.py diff workbenches/Test.pVWB",
        "problemMatcher": []
      },
      {
        "label": "8. Watch workbenches folder (Ctrl+C to stop)",
        "type": "shell",
        "command": "python vwbhist/vwbhist.py watch workbenches --interval 5",
        "isBackground": false,
        "problemMatcher": []
      },
      {
        "label": "9. Dump Test.pVWB settings text",
        "type": "shell",
        "command": "python vwbhist/vwbhist.py dump workbenches/Test.pVWB > reports/Test_dump.txt; code reports/Test_dump.txt",
        "windows": {
          "command": "if not exist reports mkdir reports & python vwbhist\\vwbhist.py dump workbenches\\Test.pVWB > reports\\Test_dump.txt & code reports\\Test_dump.txt",
          "options": {
            "shell": {
              "executable": "cmd.exe",
              "args": [
                "/d",
                "/c"
              ]
            }
          }
        },
        "problemMatcher": []
      },
      {
        "label": "10. Git: init repo with readable pVWB diffs",
        "type": "shell",
        "command": "python tests/git_setup.py",
        "problemMatcher": []
      },
      {
        "label": "11. Open the vwbhist window (GUI)",
        "type": "shell",
        "command": "python vwbhist/vwbhist_gui.py workbenches",
        "problemMatcher": []
      }
    ],
    "inputs": [
      {
        "id": "note",
        "type": "promptString",
        "description": "Note for this version",
        "default": "manual snapshot"
      }
    ]
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "vwbhist: compare demo workbenches",
        "type": "debugpy",
        "request": "launch",
        "program": "${workspaceFolder:vwbhist_test}/vwbhist/vwbhist.py",
        "args": [
          "compare",
          "workbenches/six_step_to_PWM.pVWB",
          "workbenches/EPT_SC_demo.pVWB"
        ],
        "cwd": "${workspaceFolder:vwbhist_test}",
        "console": "integratedTerminal"
      },
      {
        "name": "vwbhist: diff Test.pVWB",
        "type": "debugpy",
        "request": "launch",
        "program": "${workspaceFolder:vwbhist_test}/vwbhist/vwbhist.py",
        "args": [
          "diff",
          "workbenches/Test.pVWB"
        ],
        "cwd": "${workspaceFolder:vwbhist_test}",
        "console": "integratedTerminal"
      },
      {
        "name": "selftest",
        "type": "debugpy",
        "request": "launch",
        "program": "${workspaceFolder:vwbhist_test}/tests/selftest.py",
        "cwd": "${workspaceFolder:vwbhist_test}",
        "console": "integratedTerminal"
      }
    ]
  },
  "extensions": {
    "recommendations": [
      "ms-python.python",
      "ms-python.debugpy"
    ]
  }
}